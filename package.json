{
  "name": "devonian",
  "version": "0.4.1",
  "description": "Bidirectional Lenses for Data Portability",
  "type": "module",
  "engines": {
    "node": ">= 22.11 < 23"
  },
  "exports": {
    ".": "./src/main.ts",
    "./platform-lenses/github-issues": "./platform-lenses/github-issues/index.mjs",
    "./platform-lenses/github-issues/bridge": "./platform-lenses/github-issues/bridge.mjs",
    "./platform-lenses/github-issues/ports": "./platform-lenses/github-issues/ports.mjs",
    "./platform-lenses/github-issues/proxy": "./platform-lenses/github-issues/proxy.mjs",
    "./platform-lenses/github-issues/adapter": "./platform-lenses/github-issues/adapter.ts",
    "./platform-lenses/github-issues/tracker-actions": "./platform-lenses/github-issues/tracker-actions.ts",
    "./platform-lenses/github-issues/plugin": "./platform-lenses/github-issues/plugin.ts",
    "./platform-lenses/github-issues/plugin.js": "./platform-lenses/github-issues/plugin.js",
    "./platform-lenses/github-issues/atomic": "./platform-lenses/github-issues/atomic.ts",
    "./platform-lenses/google-calendar": "./platform-lenses/google-calendar/index.ts",
    "./platform-lenses/google-calendar/sync": "./platform-lenses/google-calendar/sync.ts",
    "./platform-lenses/google-calendar/recurrence": "./platform-lenses/google-calendar/recurrence.ts",
    "./platform-lenses/atomic-integrations": "./platform-lenses/atomic-integrations/index.ts",
    "./platform-lenses/atomic-integrations/*": "./platform-lenses/atomic-integrations/*"
  },
  "files": [
    "docs",
    "build",
    "vocab",
    "platform-lenses",
    "src"
  ],
  "devDependencies": {
    "@automerge/automerge-repo-network-broadcastchannel": "^2.0.0",
    "@automerge/automerge-repo-storage-nodefs": "^2.0.0",
    "@eslint/js": "~9.17",
    "@types/eslint__js": "~8.42",
    "@types/node": "~20",
    "@tomic/lib": "^0.40.0",
    "@typescript-eslint/parser": "~8.19",
    "@vitest/coverage-v8": "^3.0.8",
    "@vitest/eslint-plugin": "~1.1",
    "eslint": "~9.17",
    "eslint-config-prettier": "~9.1",
    "globals": "~15.14",
    "prettier": "~3.4",
    "rimraf": "~6.0",
    "ts-api-utils": "~2.0",
    "typedoc": "^0.28.4",
    "typescript": "~5.7",
    "typescript-eslint": "~8.19",
    "vitest": "^3.0.8"
  },
  "scripts": {
    "start": "node build/src/main.js",
    "clean": "rimraf coverage build tmp",
    "prebuild": "npm run lint",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "build:release": "npm run clean && tsc -p tsconfig.release.json",
    "lint": "eslint . --ignore-pattern 'docs/*' ",
    "test": "vitest run --config __tests__/vitest.config.ts",
    "test:unit": "vitest run unit --config __tests__/vitest.config.ts",
    "test:examples": "vitest run examples --config __tests__/vitest.config.ts",
    "test:coverage": "vitest run --config __tests__/vitest.config.ts --coverage.enabled --coverage.all",
    "prettier": "prettier \"{src,__{tests}__}/**/*.{ts,mts}\" --config .prettierrc --write",
    "prettier:check": "prettier \"{src,__{tests}__}/**/*.{ts,mts}\" --config .prettierrc --check",
    "test:watch": "vitest"
  },
  "author": "Michiel de Jong <michiel@unhosted.org>",
  "license": "Apache-2.0",
  "dependencies": {
    "@automerge/automerge-repo": "^2.0.0",
    "fast-json-stable-stringify": "^2.1.0",
    "effect": "^3.16.0",
    "tslib": "~2.8"
  },
  "peerDependencies": {
    "@tomic/lib": ">=0.40.0"
  },
  "volta": {
    "node": "22.12.0"
  }
}
